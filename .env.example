XLSX_PATH=/data/schedule.xlsx
DB_PATH=/data/shift_bot.db
LOG_DIR=/data/logs
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Timezone for cron schedule — must match the timezone where shift times are defined.
# The cron fires at the times in shift_hours (schedule_mapping.json) using this timezone.
# Examples: Europe/Kyiv, UTC, Europe/Warsaw

TZ=Europe/Kyiv
